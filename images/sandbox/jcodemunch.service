[Unit]
Description=JCodeMunch Watch All Service
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/mcps/jcodemunch
ExecStart=/opt/mcps/jcodemunch/.venv/bin/jcodemunch --watch-all
Restart=on-failure
RestartSec=5
Environment=PATH=/opt/mise/shims:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

[Install]
WantedBy=default.target
